diff --git a/app/lib/search_backends/database.rb b/app/lib/search_backends/database.rb
new file mode 100644
index 0000000000..eefdf76891
--- /dev/null
+++ b/app/lib/search_backends/database.rb
@@ -0,0 +1,21 @@
+# frozen_string_literal: true
+
+module SearchBackends
+  class Database < Base
+    def statuses_searchable?(_account)
+      false
+    end
+
+    def search_statuses(_query, _account, _options = {})
+      []
+    end
+
+    def search_accounts(query, account, options = {})
+      AccountSearchService.new.call(query, account, options)
+    end
+
+    def search_tags(query, options = {})
+      TagSearchService.new.call(query, options)
+    end
+  end
+end
diff --git a/app/lib/search_backends/elasticsearch.rb b/app/lib/search_backends/elasticsearch.rb
new file mode 100644
index 0000000000..1048de31fb
--- /dev/null
+++ b/app/lib/search_backends/elasticsearch.rb
@@ -0,0 +1,21 @@
+# frozen_string_literal: true
+
+module SearchBackends
+  class Elasticsearch < Base
+    def statuses_searchable?(account)
+      Chewy.enabled? && account.present?
+    end
+
+    def search_statuses(query, account, options = {})
+      StatusesSearchService.new.call(query, account, options)
+    end
+
+    def search_accounts(query, account, options = {})
+      AccountSearchService.new.call(query, account, options)
+    end
+
+    def search_tags(query, options = {})
+      TagSearchService.new.call(query, options)
+    end
+  end
+end
