From 05792abb50119b3bf807429f1bb515cc8a0071b1 Mon Sep 17 00:00:00 2001
From: Rezha Julio <contact@rezhajulio.id>
Date: Mon, 26 Oct 2026 05:39:24 +0700
Subject: [PATCH 11/11] feat(search): wire PARADEDB_DATABASE_URL to
 StatusSearchDocument connection

---
 app/lib/paradedb_query_transformer.rb |  2 +-
 app/models/status_search_document.rb  |  4 ++++
 lib/mastodon/cli/search.rb            |  8 +++++++-
 lib/tasks/paradedb.rake               | 24 ++++++++++++++++++++++++
 4 files changed, 36 insertions(+), 2 deletions(-)
 create mode 100644 lib/tasks/paradedb.rake

diff --git a/app/lib/paradedb_query_transformer.rb b/app/lib/paradedb_query_transformer.rb
index 381ef38270..c6ac528bb5 100644
--- a/app/lib/paradedb_query_transformer.rb
+++ b/app/lib/paradedb_query_transformer.rb
@@ -88,7 +88,7 @@ class ParadedbQueryTransformer
 
     def bm25_supported?
       @bm25_supported ||= begin
-        ActiveRecord::Base.connection.select_value("SELECT 1 FROM pg_am WHERE amname = 'bm25'").present?
+        StatusSearchDocument.connection.select_value("SELECT 1 FROM pg_am WHERE amname = 'bm25'").present?
       rescue
         false
       end
diff --git a/app/models/status_search_document.rb b/app/models/status_search_document.rb
index 5ca8d8ae36..e1cc84650d 100644
--- a/app/models/status_search_document.rb
+++ b/app/models/status_search_document.rb
@@ -3,6 +3,10 @@
 class StatusSearchDocument < ApplicationRecord
   self.primary_key = :status_id
 
+  if ENV['PARADEDB_DATABASE_URL'].present?
+    establish_connection URI.parse(ENV['PARADEDB_DATABASE_URL']).to_s
+  end
+
   belongs_to :status, inverse_of: :search_document, optional: true
   belongs_to :account
 
diff --git a/lib/mastodon/cli/search.rb b/lib/mastodon/cli/search.rb
index fbff9ce53d..e4a2243535 100644
--- a/lib/mastodon/cli/search.rb
+++ b/lib/mastodon/cli/search.rb
@@ -150,7 +150,13 @@ module Mastodon::CLI
 
       if options[:clean]
         say('Cleaning up orphaned search documents...')
-        StatusSearchDocument.where.not(status_id: Status.select(:id)).delete_all
+        if ENV['PARADEDB_DATABASE_URL'].present?
+          # Cross-database cleanup: fetch valid IDs in batches
+          valid_ids = Status.pluck(:id)
+          StatusSearchDocument.where.not(status_id: valid_ids).delete_all
+        else
+          StatusSearchDocument.where.not(status_id: Status.select(:id)).delete_all
+        end
       end
 
       say('ParadeDB status search documents populated successfully!', :green)
diff --git a/lib/tasks/paradedb.rake b/lib/tasks/paradedb.rake
new file mode 100644
index 0000000000..036258438d
--- /dev/null
+++ b/lib/tasks/paradedb.rake
@@ -0,0 +1,24 @@
+# frozen_string_literal: true
+
+namespace :paradedb do
+  desc 'Run migrations against dedicated PARADEDB_DATABASE_URL'
+  task migrate: :environment do
+    if ENV['PARADEDB_DATABASE_URL'].blank?
+      puts 'PARADEDB_DATABASE_URL not set, running via standard db:migrate.'
+      Rake::Task['db:migrate'].invoke
+      next
+    end
+
+    puts "Migrating dedicated ParadeDB database at #{ENV['PARADEDB_DATABASE_URL']}..."
+    connection = StatusSearchDocument.connection
+
+    migration_file = Rails.root.join('db/migrate/20261025210000_create_status_search_documents.rb')
+    require migration_file
+
+    ActiveRecord::Migration.suppress_messages do
+      CreateStatusSearchDocuments.new.exec_migration(connection, :up)
+    end
+
+    puts 'ParadeDB dedicated database migration complete.'
+  end
+end
-- 
2.56.0

