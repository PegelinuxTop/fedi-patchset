+// Tangerine Cherry theme - simplified diff focusing on CSS token usage
+// Most styling is now handled by the theme tokens defined in theme/
+
+// Custom overrides specific to Tangerine Cherry theme can go here
+.button.button-tertiary {
+  border: 1px solid var(--color-text-brand) !important;
+  color: var(--color-text-brand) !important;
+}
