diff --git a/app/javascript/styles/tangerineui-cherry/theme/index.scss b/app/javascript/styles/tangerineui-cherry/theme/index.scss
new file mode 100644
index 0000000000..5b73d4cb36
--- /dev/null
+++ b/app/javascript/styles/tangerineui-cherry/theme/index.scss
@@ -0,0 +1,15 @@
+@use './_base' as base;
+@use './_dark' as dark;
+@use './_light' as light;
+
+:root {
+  @include base.palette;
+
+  @media (prefers-color-scheme: dark) {
+    @include dark.tokens;
+  }
+
+  @media (prefers-color-scheme: light) {
+    @include light.tokens;
+  }
+}
