@@ -0,0 +1,15 @@
+@use '../../mastodon/tokens/theme/utils';
+
+@mixin tokens {
+  // Dark mode CSS tokens for Tangerine UI
+  --color-bg-primary: #000;
+  --color-bg-secondary-solid: #1a1a1a;
+  --color-bg-secondary-base: #262626;
+  --color-bg-tertiary: #333;
