+@use 'sass:color';
+
+.layout-multiple-columns
+  #mastodon
+  .columns-area
+  .status__action-bar
+  :not(i, .status__action-bar-spacer) {
+  max-width: unset !important;
+}
+
+body.app-body.flavour-glitch > #mastodon .compose-form__submit {
+  position: unset !important;
+  margin-top: unset !important;
+}
+
+@media (width <= 759px) {
+  .navigation-panel__list-panel__header span,
+  .navigation-panel__list-panel button,
+  .column-link span {
+    visibility: collapse;
+  }
+
+  .navigation-panel__menu {
+    display: flex;
+    margin: 0 5px;
+    width: 98%;
+
+    & .icon.icon-down {
+      position: absolute;
+    }
+
+    a,
+    div,
+    button {
+      max-width: none;
+      width: inherit;
+    }
+
+    a:not(.button),
+    div:not(.sign-in-banner),
+    button {
+      padding: unset !important;
+      display: flex;
+      flex: 1 1 auto;
+    }
+
+    > span,
+    .column-link > span {
+      position: absolute;
+    }
+  }
+
+  .navigation-panel__sign-in-banner {
+    max-width: 60%;
+  }
+
+  .sign-in-banner {
+    > p {
+      visibility: hidden;
+      position: absolute;
+    }
+  }
+
+  .ui__header .ui__header__links {
+    right: unset !important;
+    inset-inline-end: unset !important;
+  }
+
