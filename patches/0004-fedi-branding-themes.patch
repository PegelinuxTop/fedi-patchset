@@ -0,0 +1,15 @@
+@use '../../mastodon/tokens/theme/utils';
+
+@mixin tokens {
+  // Light mode CSS tokens for Tangerine Purple
+  --color-bg-primary: #fff;
+  --color-bg-secondary-solid: #f0f0f0;
+  --color-bg-secondary-base: #e8e8e8;
+  --color-bg-tertiary: #e0e0e0;
+  --color-bg-brand-base: #9c27b0;
+  --color-bg-brand-base-hover: darken(#9c27b0, 10%);
+  --color-text-primary: #000;
+  --color-text-secondary: #666;
+  --color-text-brand: #9c27b0;
+  --color-text-on-brand-base: #fff;
+}
diff --git a/app/javascript/styles/tangerineui-purple/theme/index.scss b/app/javascript/styles/tangerineui-purple/theme/index.scss
new file mode 100644
index 0000000000..5b73d4cb36
--- /dev/null
+++ b/app/javascript/styles/tangerineui-purple/theme/index.scss
@@ -0,0 +1,15 @@
+@use './_base' as base;
+@use './_dark' as dark;
+@use './_light' as light;
+
+:root {
+  @include base.palette;
+
+  @media (prefers-color-scheme: dark) {
+    @include dark.tokens;
+  }
+
+  @media (prefers-color-scheme: light) {
+    @include light.tokens;
