diff --git a/app/lib/search/backends/database.rb b/app/lib/search/backends/database.rb
new file mode 100644
index 0000000000..047477c485
--- /dev/null
+++ b/app/lib/search/backends/database.rb
@@ -0,0 +1,23 @@
+# frozen_string_literal: true
+
+module Search
+  module Backends
+    class Database < Base
+      def statuses_searchable?(_account)
+        false
+      end
+
+      def search_statuses(_query, _account, _options = {})
+        []
+      end
+
+      def search_accounts(query, account, options = {})
+        AccountSearchService.new.call(query, account, options)
+      end
+
+      def search_tags(query, options = {})
+        TagSearchService.new.call(query, options)
+      end
+    end
+  end
+end
diff --git a/app/lib/search/backends/elasticsearch.rb b/app/lib/search/backends/elasticsearch.rb
