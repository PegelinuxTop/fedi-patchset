diff --git a/.env.production.sample b/.env.production.sample
index 2a6b0568d7..ec46829c7d 100644
--- a/.env.production.sample
+++ b/.env.production.sample
@@ -56,6 +56,17 @@ DB_PASS=
 DB_PORT=5432
 
 
+# Search Backend configuration
+# ----------------------------
+# Options: elasticsearch (default if ES_ENABLED=true), paradedb, database
+# SEARCH_BACKEND=paradedb
+
+# ParadeDB settings (when SEARCH_BACKEND=paradedb)
+# Optional dedicated Postgres search DB URL (defaults to primary application DB)
+# PARADEDB_DATABASE_URL=postgresql://mastodon:secret@paradedb:5432/mastodon_search
+# Enable dual-writing to both ES and ParadeDB during migration
+# SEARCH_DUAL_WRITE=false
+
 # Elasticsearch (optional)
 # ------------------------
 #ES_ENABLED=true
diff --git a/app/lib/search/backend.rb b/app/lib/search/backend.rb
new file mode 100644
index 0000000000..fd08c83301
--- /dev/null
+++ b/app/lib/search/backend.rb
@@ -0,0 +1,49 @@
+# frozen_string_literal: true
+
+module Search
+  class Backend
+    class << self
+      def current
+        @current ||= begin
+          backend_name = ENV.fetch('SEARCH_BACKEND') do
+            Chewy.enabled? ? 'elasticsearch' : 'database'
+          end.downcase
+
+          case backend_name
+          when 'paradedb'
+            Backends::Paradedb.new
+          when 'elasticsearch', 'chewy', 'es'
+            Backends::Elasticsearch.new
+          else
+            Backends::Database.new
+          end
+        end
+      end
+
+      # Reset cached backend (useful in testing)
+      def reset!
+        @current = nil
+      end
+
+      def search_enabled?
+        !database? && (paradedb? || Chewy.enabled?)
+      end
+
+      def paradedb?
+        current.is_a?(Backends::Paradedb)
+      end
+
+      def elasticsearch?
+        current.is_a?(Backends::Elasticsearch)
+      end
+
+      def database?
+        current.is_a?(Backends::Database)
+      end
+
+      def dual_write?
+        ENV['SEARCH_DUAL_WRITE'] == 'true'
+      end
+    end
+  end
+end
